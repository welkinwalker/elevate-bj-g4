# =============================================================================
# Project Elevate Environment Configuration
# =============================================================================

# Gemini API & Vertex AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
APP_NAME=elevate-hr-agent

# Multi-Tenant Session Defaults
DEFAULT_EMPLOYEE_ID=EMP-1002

# FastMCP Remote Microservice URLs
WORKWEEK_MCP_URL=https://mock-saas.aishprabhat.demo.altostrat.com/work-week/mcp/
SERVICEIMMEDIATELY_MCP_URL=https://mock-saas.aishprabhat.demo.altostrat.com/service-immediately/mcp/
MCP_TOKEN=mcp_your_token_here

# Local Development & Offline Mock Mode
ENABLE_LOCAL_MOCK_FALLBACK=true

# Private Package Registry & Corp Airlock Mirrors
# UV_INDEX_URL=https://corp-airlock-mirror.internal/simple
# PIP_INDEX_URL=https://corp-airlock-mirror.internal/simple
# ARTIFACT_REGISTRY_URL=https://us-central1-python.pkg.dev/your-project/python-repo/simple/

# Vertex AI Search & RAG Settings
GOOGLE_CLOUD_PROJECT=gcp-elevate-dev
VERTEX_AI_SEARCH_LOCATION=global
VERTEX_AI_DATA_STORE_ID=hr-policies-elevate-store
VERTEX_AI_SEARCH_ENGINE_ID=hr-policies-elevate-engine

# Model Armor Settings
MODEL_ARMOR_TEMPLATE_ID=elevate-safety-template
# MODEL_ARMOR_ENDPOINT=https://modelarmor.googleapis.com/v1/projects/gcp-elevate-dev/locations/global/templates/elevate-safety-template:sanitizeUserPrompt
