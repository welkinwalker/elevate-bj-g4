# =============================================================================
# Project Elevate: HR & IT Agentic Solution — Environment Configuration
# =============================================================================

# --- Gemini Model & Auth ---
# Options: gemini-2.5-flash, gemini-2.5-pro, gemini-1.5-flash, gemini-3.5-flash
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here

# --- Vertex AI Search RAG (Track A Production) ---
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=your_gcp_project_id_here
GOOGLE_CLOUD_LOCATION=global
VERTEX_AI_DATA_STORE_ID=hr-policies-elevate-store
VERTEX_AI_SEARCH_ENGINE_ID=hr-policies-elevate-engine

# --- FastMCP Enterprise Endpoints & Credentials ---
# In production, bypass IAP with custom X-MCP-Token header
WORKWEEK_MCP_URL=https://mock-saas.aishprabhat.demo.altostrat.com/work-week/mcp/
SERVICEIMMEDIATELY_MCP_URL=https://mock-saas.aishprabhat.demo.altostrat.com/service-immediately/mcp/
MCP_TOKEN=mcp_your_token_here

# --- Default User & Session Config ---
DEFAULT_EMPLOYEE_ID=EMP-1002
APP_NAME=elevate-hr-agent
ENABLE_LOCAL_MOCK_FALLBACK=true
